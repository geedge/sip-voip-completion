    <repositories>
        <repository>
            <id>nexus</id>
            <name>Team Nexus Repository</name>
            <url>http://192.168.40.125:8099/content/groups/public</url>
        </repository>

        <repository>
            <id>ebi</id>
            <name>www.ebi.ac.uk</name>
            <url>http://www.ebi.ac.uk/intact/maven/nexus/content/groups/public/</url>
        </repository>

